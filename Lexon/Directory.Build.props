<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Product metadata only. The shipped version lives in
         Lexon.Settings.csproj so crash reports and About stay in sync. -->
    <Product>Lexon</Product>
    <Company>Lexon</Company>
    <Copyright>Copyright © 2026 Lexon. All rights reserved.</Copyright>
    <Trademark>Lexon</Trademark>

    <!-- Build Information -->
    <Authors>Lexon</Authors>
    <Description>AI-powered typing assistant for Windows with privacy-first design</Description>
    <PackageProjectUrl>https://lexon.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lexon/lexon</RepositoryUrl>
    <PackageLicenseExpression>Proprietary</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
  </PropertyGroup>
</Project>
