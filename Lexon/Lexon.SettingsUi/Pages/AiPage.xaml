<UserControl x:Class="Lexon.SettingsUi.AiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lexon.SettingsUi"
             xmlns:model="clr-namespace:Lexon.SettingsModel;assembly=Lexon.SettingsModel">
  <UserControl.Resources>
    <local:AiStatusBrushConverter x:Key="AiStatusBrushConverter"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </UserControl.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Focusable="False">
    <StackPanel Margin="16" HorizontalAlignment="Stretch">
      <local:SectionHeader Title="AI" Margin="0,0,0,12" IsTabStop="False"/>

      <local:InlineBanner Margin="0,0,0,12" IsTabStop="False"
                          AutomationProperties.Name="Live settings. Changes here are saved.">
        <TextBlock Text="Live settings. Changes here are saved." TextWrapping="Wrap"
                   Foreground="{DynamicResource TextBrush}"
                   FontFamily="{DynamicResource LexonFontFamily}"
                   FontSize="{DynamicResource BodyFontSize}"/>
      </local:InlineBanner>

      <local:Card IsTabStop="False">
        <StackPanel>
          <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" Margin="0,0,0,4"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource BodyFontSize}"
                     AutomationProperties.Name="{Binding Heading}"/>
          <TextBlock Text="{x:Static model:AiSettingsViewModel.ProviderHint}"
                     TextWrapping="Wrap" Margin="0,0,0,8"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource CaptionFontSize}"/>

          <Button Content="More providers"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,8"
                  Click="OnMoreProviders"
                  Style="{DynamicResource SubtleButton}"
                  Visibility="{Binding ShowMoreProvidersLink, Converter={StaticResource BoolToVis}}"
                  AutomationProperties.Name="More providers"
                  AutomationProperties.HelpText="{x:Static model:AiSettingsViewModel.ProviderHint}"/>

          <ComboBox ItemsSource="{x:Static model:AiSettingsViewModel.ProviderLabels}"
                    SelectedIndex="{Binding ProviderIndex}"
                    HorizontalAlignment="Stretch" MinWidth="0"
                    Margin="0,0,0,12"
                    Visibility="{Binding ShowProviderCombo, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="AI provider"
                    AutomationProperties.HelpText="{x:Static model:AiSettingsViewModel.ProviderHint}"/>

          <Button Content="Get your API key"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,4"
                  Click="OnGetApiKey"
                  Style="{DynamicResource SecondaryButton}"
                  Visibility="{Binding ShowGetKeyButton, Converter={StaticResource BoolToVis}}"
                  AutomationProperties.Name="Get your API key"
                  AutomationProperties.HelpText="{x:Static model:AiSettingsViewModel.GetKeyHint}"/>
          <TextBlock Text="{x:Static model:AiSettingsViewModel.GetKeyHint}"
                     TextWrapping="Wrap" Margin="0,0,0,12"
                     Visibility="{Binding ShowGetKeyButton, Converter={StaticResource BoolToVis}}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource CaptionFontSize}"/>

          <TextBlock Text="API key" TextWrapping="Wrap" Margin="0,0,0,4"
                     Visibility="{Binding ShowKeyBox, Converter={StaticResource BoolToVis}}"
                     Foreground="{DynamicResource TextBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource BodyFontSize}"/>
          <local:RevealPasswordBox Password="{Binding ApiKeyText, UpdateSourceTrigger=PropertyChanged}"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding ShowKeyBox, Converter={StaticResource BoolToVis}}"
                                   IsKeyboardFocusWithinChanged="OnKeyFocusWithinChanged"
                                   AutomationProperties.Name="API key"
                                   AutomationProperties.HelpText="Paste an API key to connect."/>

          <Button Content="Cancel"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,8"
                  Click="OnCancelWait"
                  Style="{DynamicResource SecondaryButton}"
                  Visibility="{Binding IsWaitingForClipboard, Converter={StaticResource BoolToVis}}"
                  AutomationProperties.Name="Cancel"
                  AutomationProperties.HelpText="Stop watching the clipboard for an API key."/>

          <TextBlock Text="{Binding StatusActiveLine}" TextWrapping="Wrap" Margin="0,0,0,4"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource BodyFontSize}"
                     AutomationProperties.Name="AI active status"
                     AutomationProperties.LiveSetting="Polite"/>
          <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" Margin="0,0,0,12"
                     Foreground="{Binding StatusKind, Converter={StaticResource AiStatusBrushConverter}}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource BodyFontSize}"
                     AutomationProperties.Name="AI status detail"
                     AutomationProperties.LiveSetting="Polite"/>

          <TextBlock Text="{x:Static model:AiSettingsViewModel.CloudExplainText}"
                     TextWrapping="Wrap" Margin="0,0,0,12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource CaptionFontSize}"/>

          <CheckBox Content="Send words around the cursor to cloud AI while I type"
                    IsChecked="{Binding AiSuggestionsWhileTyping}"
                    IsEnabled="{Binding AiFlagsEnabled}"
                    AutomationProperties.Name="Send words around the cursor to cloud AI while I type"
                    AutomationProperties.HelpText="Off by default. Applies to OpenAI, Gemini, DeepSeek, and Ollama that is not on this PC. Local Ollama and plugins still work unless Local-only is on."/>
          <TextBlock Text="Off by default. Applies to OpenAI, Gemini, DeepSeek, and Ollama that is not on this PC. Local Ollama and plugins still work unless Local-only is on."
                     TextWrapping="Wrap" Margin="0,4,0,12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource CaptionFontSize}"/>

          <CheckBox Content="Allow AI rewrites of selected text"
                    IsChecked="{Binding AiRewriteOnRequest}"
                    IsEnabled="{Binding AiFlagsEnabled}"
                    AutomationProperties.Name="Allow AI rewrites of selected text"
                    AutomationProperties.HelpText="Explicit rewrites from the Aa chip or shortcut. Does not send text until you ask."/>
          <TextBlock Text="Explicit rewrites from the Aa chip or shortcut. Does not send text until you ask."
                     TextWrapping="Wrap" Margin="0,4,0,12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource CaptionFontSize}"/>

          <CheckBox Content="Prepare a rewrite as soon as I select text"
                    IsChecked="{Binding AiPrefetchOnSelection}"
                    IsEnabled="{Binding AiFlagsEnabled}"
                    AutomationProperties.Name="Prepare a rewrite as soon as I select text"
                    AutomationProperties.HelpText="Off by default. When on, selecting text may send it before you pick a rewrite."/>
          <TextBlock Text="Off by default. When on, selecting text may send it before you pick a rewrite."
                     TextWrapping="Wrap" Margin="0,4,0,12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource CaptionFontSize}"/>

          <TextBlock Text="Model" TextWrapping="Wrap" Margin="0,0,0,4"
                     Visibility="{Binding ShowModel, Converter={StaticResource BoolToVis}}"
                     Foreground="{DynamicResource TextBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource BodyFontSize}"/>
          <ComboBox ItemsSource="{Binding Models}"
                    SelectedItem="{Binding SelectedModel}"
                    HorizontalAlignment="Stretch" MinWidth="0"
                    Visibility="{Binding ShowModel, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="Model"
                    AutomationProperties.HelpText="Filled automatically. Change only if you want a different model."/>
          <TextBlock Text="Filled automatically. Change only if you want a different model."
                     TextWrapping="Wrap" Margin="0,4,0,0"
                     Visibility="{Binding ShowModel, Converter={StaticResource BoolToVis}}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource CaptionFontSize}"/>
        </StackPanel>
      </local:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
