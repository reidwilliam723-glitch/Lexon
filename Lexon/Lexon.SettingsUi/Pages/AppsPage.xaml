<UserControl x:Class="Lexon.SettingsUi.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lexon.SettingsUi"
             xmlns:model="clr-namespace:Lexon.SettingsModel;assembly=Lexon.SettingsModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Focusable="False">
    <StackPanel Margin="16" HorizontalAlignment="Stretch">
      <local:SectionHeader Title="Apps" Margin="0,0,0,12" IsTabStop="False"/>

      <local:InlineBanner Margin="0,0,0,12" IsTabStop="False"
                          AutomationProperties.Name="Live settings. Changes here are saved.">
        <TextBlock Text="Live settings. Changes here are saved." TextWrapping="Wrap"
                   Foreground="{DynamicResource TextBrush}"
                   FontFamily="{DynamicResource LexonFontFamily}"
                   FontSize="{DynamicResource BodyFontSize}"/>
      </local:InlineBanner>

      <local:Card IsTabStop="False">
        <StackPanel>
          <TextBlock Text="These are the same lists as Privacy, App tone, and Writing, shown for one app."
                     TextWrapping="Wrap" Margin="0,0,0,12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource CaptionFontSize}"/>

          <ListBox ItemsSource="{Binding Apps}"
                   SelectedIndex="{Binding SelectedIndex}"
                   Height="110"
                   Margin="0,0,0,8"
                   HorizontalAlignment="Stretch"
                   MinWidth="0"
                   AutomationProperties.Name="Apps"
                   AutomationProperties.HelpText="Apps with a block, a tone, or an exclusion. Pick one to change it."/>

          <Button Content="Add running app…"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,12"
                  Click="OnAddRunningApp"
                  Style="{DynamicResource SecondaryButton}"
                  AutomationProperties.Name="Add running app…"
                  AutomationProperties.HelpText="Choose a running app, then turn features on or off for it."/>

          <CheckBox Content="Block assistance"
                    IsChecked="{Binding BlockAssistance}"
                    IsEnabled="{Binding HasApp}"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="Block assistance"
                    AutomationProperties.HelpText="Lexon skips this app. Password fields are always skipped."/>

          <TextBlock Text="Writing tone" TextWrapping="Wrap" Margin="0,0,0,4"
                     Foreground="{DynamicResource TextBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource BodyFontSize}"/>
          <ComboBox ItemsSource="{x:Static model:AppsSettingsViewModel.ToneChoices}"
                    SelectedIndex="{Binding ToneIndex}"
                    IsEnabled="{Binding HasApp}"
                    HorizontalAlignment="Stretch" MinWidth="0"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="Writing tone"
                    AutomationProperties.HelpText="Default keeps the built-in tone. Casual, Formal, Code, or Neutral overrides it."/>

          <CheckBox Content="Suggest grammar"
                    IsChecked="{Binding Grammar}"
                    IsEnabled="{Binding HasApp}"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="Suggest grammar"
                    AutomationProperties.HelpText="Turn off to stop grammar suggestions in this app."/>

          <CheckBox Content="Use learned words"
                    IsChecked="{Binding LearnedWords}"
                    IsEnabled="{Binding HasApp}"
                    AutomationProperties.Name="Use learned words"
                    AutomationProperties.HelpText="Turn off to hide words Lexon learned from you in this app. Ordinary dictionary words stay."/>
        </StackPanel>
      </local:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
