<UserControl x:Class="Lexon.SettingsUi.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lexon.SettingsUi"
             xmlns:model="clr-namespace:Lexon.SettingsModel;assembly=Lexon.SettingsModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Focusable="False">
    <StackPanel Margin="16" HorizontalAlignment="Stretch">
      <local:SectionHeader Title="Appearance" Margin="0,0,0,12" IsTabStop="False"/>

      <local:InlineBanner Margin="0,0,0,12" IsTabStop="False"
                          AutomationProperties.Name="Live settings. Changes here are saved.">
        <TextBlock Text="Live settings. Changes here are saved." TextWrapping="Wrap"
                   Foreground="{DynamicResource TextBrush}"
                   FontFamily="{DynamicResource LexonFontFamily}"
                   FontSize="{DynamicResource BodyFontSize}"/>
      </local:InlineBanner>

      <local:Card IsTabStop="False">
        <StackPanel>
          <TextBlock Text="Theme" TextWrapping="Wrap" Margin="0,0,0,4"
                     Foreground="{DynamicResource TextBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource BodyFontSize}"/>
          <ComboBox ItemsSource="{x:Static model:AppearanceSettingsViewModel.ThemeLabels}"
                    SelectedIndex="{Binding ThemeIndex}"
                    HorizontalAlignment="Stretch" MinWidth="0"
                    AutomationProperties.Name="Theme"
                    AutomationProperties.HelpText="Colours for Settings and the overlay."/>
          <TextBlock Text="Colours for Settings and the overlay."
                     TextWrapping="Wrap" Margin="0,4,0,12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource CaptionFontSize}"/>

          <TextBlock Text="Suggestion order" TextWrapping="Wrap" Margin="0,0,0,4"
                     Foreground="{DynamicResource TextBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource BodyFontSize}"/>
          <ComboBox ItemsSource="{x:Static model:AppearanceSettingsViewModel.SortLabels}"
                    SelectedIndex="{Binding SortIndex}"
                    HorizontalAlignment="Stretch" MinWidth="0"
                    AutomationProperties.Name="Suggestion order"
                    AutomationProperties.HelpText="How chips are sorted when several matches appear."/>
          <TextBlock Text="How chips are sorted when several matches appear."
                     TextWrapping="Wrap" Margin="0,4,0,12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource CaptionFontSize}"/>

          <TextBlock Text="Suggestion position" TextWrapping="Wrap" Margin="0,0,0,4"
                     Foreground="{DynamicResource TextBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource BodyFontSize}"/>
          <ComboBox ItemsSource="{x:Static model:AppearanceSettingsViewModel.PlacementLabels}"
                    SelectedIndex="{Binding PlacementIndex}"
                    HorizontalAlignment="Stretch" MinWidth="0"
                    AutomationProperties.Name="Suggestion position"
                    AutomationProperties.HelpText="Where the overlay sits relative to the current word."/>
          <TextBlock Text="Where the overlay sits relative to the current word."
                     TextWrapping="Wrap" Margin="0,4,0,12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource CaptionFontSize}"/>

          <TextBlock Text="Accept suggestion with" TextWrapping="Wrap" Margin="0,0,0,4"
                     Foreground="{DynamicResource TextBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource BodyFontSize}"/>
          <ComboBox ItemsSource="{x:Static model:AppearanceSettingsViewModel.AcceptKeyLabels}"
                    SelectedIndex="{Binding AcceptKeyIndex}"
                    HorizontalAlignment="Stretch" MinWidth="0"
                    AutomationProperties.Name="Accept suggestion with"
                    AutomationProperties.HelpText="Which key accepts the highlighted suggestion. Space never accepts. 1, 2, and 3 still insert the numbered rows. Enter is not sent to the app while the list is open, so a chat message is not sent as well."/>
          <TextBlock Text="Space never accepts. 1, 2, and 3 still insert the numbered rows. Enter is not sent to the app while the list is open, so a chat message is not sent as well."
                     TextWrapping="Wrap" Margin="0,4,0,12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource CaptionFontSize}"/>

          <CheckBox Content="Preview AI rewrites before applying"
                    IsChecked="{Binding PreviewRewrites}"
                    AutomationProperties.Name="Preview AI rewrites before applying"
                    AutomationProperties.HelpText="Show a preview before an AI rewrite is applied."/>
          <TextBlock Text="Show a preview before an AI rewrite is applied."
                     TextWrapping="Wrap" Margin="0,4,0,0"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="{DynamicResource LexonFontFamily}"
                     FontSize="{DynamicResource CaptionFontSize}"/>
        </StackPanel>
      </local:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
