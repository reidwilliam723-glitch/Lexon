<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Lexon.SettingsUi</RootNamespace>
    <EnableDefaultPageItems>true</EnableDefaultPageItems>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Media" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lexon.Core\Lexon.Core.csproj" />
    <ProjectReference Include="..\Lexon.SettingsModel\Lexon.SettingsModel.csproj" />
  </ItemGroup>
</Project>
