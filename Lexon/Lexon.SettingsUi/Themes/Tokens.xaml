<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <FontFamily x:Key="LexonFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

  <sys:Double x:Key="CaptionFontSize">12</sys:Double>
  <sys:Double x:Key="BodyFontSize">14</sys:Double>
  <sys:Double x:Key="SubtitleFontSize">16</sys:Double>
  <sys:Double x:Key="TitleFontSize">20</sys:Double>
  <sys:Double x:Key="DisplayFontSize">28</sys:Double>

  <sys:Double x:Key="Space4">4</sys:Double>
  <sys:Double x:Key="Space8">8</sys:Double>
  <sys:Double x:Key="Space12">12</sys:Double>
  <sys:Double x:Key="Space16">16</sys:Double>
  <sys:Double x:Key="Space24">24</sys:Double>
  <sys:Double x:Key="Space32">32</sys:Double>

  <CornerRadius x:Key="RadiusControl">6</CornerRadius>
  <CornerRadius x:Key="RadiusCard">10</CornerRadius>
  <CornerRadius x:Key="RadiusDialog">12</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <FontWeight x:Key="BodyStrongWeight">SemiBold</FontWeight>
  <PopupAnimation x:Key="PopupAnimation">Slide</PopupAnimation>
</ResourceDictionary>
